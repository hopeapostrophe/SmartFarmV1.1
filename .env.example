# SmartFarm V1.1 — environment variables
#
# Copy this file to "smap.env" in the project root and fill in your values.
# smap.env is gitignored and must NEVER be committed or shared.
# On Render: do NOT upload smap.env — instead add these variables in
# Dashboard -> your service -> Environment (see README "Deployment").
#
# The app reads real environment variables first; smap.env is only a
# convenience for local runs (loaded automatically via python-dotenv).

# ---------- NASA SMAP (raw satellite soil-moisture, SPL4SMGP via AppEEARS) ----------
# Without these two the app falls back to NASA POWER (still real NASA data,
# coarser) — it will work, but the SMAP endpoints stay disabled.
# How to get them (free):
#   1. Register at https://urs.earthdata.nasa.gov
#   2. Authorize AppEEARS for your account:
#      https://urs.earthdata.nasa.gov -> Profile -> Authorized Apps ->
#      search "AppEEARS" -> Authorize  (https://appeears.earthdatacloud.nasa.gov)
EARTHDATA_USER=your_earthdata_username
EARTHDATA_PASS=your_earthdata_password

# ---------- AI assistant (Google Gemini, OpenAI-compatible endpoint) ----------
# Free key: https://aistudio.google.com/apikey
# Used only server-side; the browser never sees it. If unset, users can paste
# their own key in the chat's "API Keys" panel (stored in their browser only).
GEMINI_API_KEY=your_gemini_api_key

# ---------- Optional overrides (sane defaults built in) ----------
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# AI_MODEL=gemini-3.6-flash
# AI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.1-flash-lite,gemini-3-flash-preview
# AI_API_KEY=              # overrides GEMINI_API_KEY if set

# ---------- Optional: lock the whole site behind a login ----------
# If SITE_PASSWORD is set, every page/API requires HTTP Basic auth.
# The sensor ingest endpoint is exempt (it uses SENSOR_KEY instead).
# SITE_USER=admin
# SITE_PASSWORD=change-me

# ---------- Optional: physical soil-moisture sensor (USB bridge) ----------
# SENSOR_KEY protects POST /api/v1/sensor/ingest. Any long random string works.
# SENSOR_KEY=some-long-random-string
# SENSOR_MODE=volumetric        # volumetric (m3/m3) | relative (% saturation)
# SENSOR_RAW_DRY=1023           # raw ADC reading in air (sensor completely dry)
# SENSOR_RAW_WET=300            # raw ADC reading in water (sensor fully wet)
# SERIAL_BAUD=9600              # only used when reading a port directly on the server
# SERIAL_PORT=                  # e.g. COM5 or /dev/ttyUSB0 — empty = bridge posts via HTTP instead

# ---------- Optional: paths and model tweaks ----------
# DB_PATH=./data/app.db         # SQLite history + SMAP cache (created automatically)
# MODEL_PATH=./models/best.pt   # disease/segmentation weights (included in repo)
# MODEL_SEG_PATH=./models/seg.pt
# SEG_LABEL=                    # display name for "Class 0" from the segmentation model
# DISEASE_KEYWORDS=scab,rust,spot   # comma-separated markers for "is a disease" classes
# MAX_IMAGE_MB=60
# MAX_VIDEO_MB=600

# ---------- Optional: USB bridge (runs on your PC, not on the server) ----------
# AGRO_SERVER_URL=http://localhost:8001     # local dev; use your Render URL in the field
